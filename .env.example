# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN pernah membagikan atau meng-commit file .env.
# Semua variabel bersifat OPSIONAL: tanpa satu pun, aplikasi tetap berjalan
# (Scanner, Latihan, Langkah Aman, dan Guardian AI mode lokal).

# 1) Guardian AI (opsional). Kunci gratis dibuat di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Biarkan kosong agar aplikasi memilih model Gemini yang masih aktif secara otomatis.
# Isi hanya jika ingin memaksa model tertentu, misalnya gemini-flash-latest
GEMINI_MODEL=

# 2) Akun dan progres latihan (opsional). Connection string Postgres dari https://neon.tech
#    (Dashboard Neon > Connect > salin "Connection string", boleh yang pooled).
#    Jika kosong saat pengembangan lokal, akun disimpan di berkas .data/users.json (tidak ikut git).
#    Jika kosong di Vercel, fitur akun otomatis nonaktif dan menu Masuk disembunyikan.
DATABASE_URL=

# Rahasia untuk menandatangani cookie sesi login. Isi teks acak panjang (minimal 32 karakter),
# misalnya hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
